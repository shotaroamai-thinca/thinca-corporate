# =====================================
# Docker
# =====================================
# DB のデータは永続化用なのでGit管理しない
db_data/

# =====================================
# WordPress 関連（新構造 public/ 配下）
# =====================================
# アップロード画像は容量が大きいので除外（必要なら別途rsync）
public/wp/wp-content/uploads/

# キャッシュ系
public/wp/wp-content/cache/
public/wp/wp-content/upgrade/
public/wp/wp-content/backup/

# プラグイン由来のバックアップ（容量大）
public/wp/wp-content/ai1wm-backups/
public/wp/wp-content/updraft/

# =====================================
# WordPress 設定ファイル（機密情報・絶対commitしない）
# =====================================
# wp-config.php（Docker起動時にローカル用に自動生成・本番DB情報を含む可能性）
public/wp-config.php
public/wp/wp-config.php

# wp-config.php のバックアップ（本番DB情報入り）
*.production-backup
public/**/*backup*
public/**/*.bak

# =====================================
# DBダンプ・機密情報
# =====================================
*.sql
*.sql.gz
*.dump
.env
.env.local

# =====================================
# OS / IDE
# =====================================
.DS_Store
Thumbs.db
*.swp
*.swo
.vscode/
.idea/
*.log

# =====================================
# Node / その他
# =====================================
node_modules/
dist/
.cache/

# =====================================
# 旧構造の名残（クリーンビルド前のパス）
# =====================================
# 念のため旧パスも除外
wp-content/uploads/
wp-content/ai1wm-backups/
wp-content/updraft/
</content>
</invoke>